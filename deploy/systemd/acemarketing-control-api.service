[Unit]
Description=AceMarketing control API
After=network-online.target acemarketing-preflight.service
Requires=acemarketing-preflight.service
Wants=network-online.target

[Service]
Type=simple
User=acemarketing
Group=acemarketing
WorkingDirectory=/opt/acemarketing/current
EnvironmentFile=/etc/acemarketing/acemarketing.env
ExecStart=/usr/bin/node backend/src/control-api.mjs
Restart=always
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/acemarketing /tmp
LimitNOFILE=65536

[Install]
WantedBy=acemarketing-standard.target
