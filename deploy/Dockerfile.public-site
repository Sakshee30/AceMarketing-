FROM node:20-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY tsconfig.json tsconfig.app.json vite.public-site.config.ts ./
COPY website ./website
COPY frontend ./frontend
COPY packages ./packages
ARG PUBLIC_SITE_ORIGIN=https://acemarketing.example.test
ENV PUBLIC_SITE_ORIGIN=$PUBLIC_SITE_ORIGIN
RUN npm run build:public-site

FROM nginx:1.27-alpine
COPY deploy/nginx.public-site.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/public-site /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O - http://127.0.0.1/healthz >/dev/null || exit 1
