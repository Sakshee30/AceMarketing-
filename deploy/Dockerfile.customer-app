FROM node:20-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY tsconfig.json tsconfig.app.json vite.customer-app.config.ts ./
COPY frontend ./frontend
COPY packages ./packages
RUN npm run build:customer-app

FROM nginx:1.27-alpine
COPY deploy/nginx.customer-app.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/customer-app /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O - http://127.0.0.1/healthz >/dev/null || exit 1
