FROM node:20-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY vite.platform-admin.config.ts ./
COPY frontend ./frontend
COPY packages ./packages
RUN npm run build:platform-admin

FROM nginx:1.27-alpine
COPY deploy/nginx.platform-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/platform-admin /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O - http://127.0.0.1/healthz >/dev/null || exit 1
