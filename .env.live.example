# Copy to .env.live.local. Use a dedicated LOCAL PostgreSQL database.
NODE_ENV=development
PORT=3001
DEFAULT_WORKSPACE_ID=ws_default
DATABASE_URL=postgresql://ace_live:CHANGE_ME@127.0.0.1:5432/ace_live
ACE_LIVE_WSL=false
# Python 3.11-3.13 executable; use python3 on macOS/Linux if needed.
PYTHON_BIN=python
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=demo123
ACE_LOCAL_PASSWORD=demo123
ML_SERVICE_URL=http://127.0.0.1:8000
# live:setup -- --native generates missing local secrets and installs Python dependencies.
JWT_SECRET=
ML_SERVICE_AUTH_TOKEN=
CALL_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
ACE_ENABLE_AI=true
ACE_ENABLE_CALL_TRACKING=true
ACE_ENABLE_WHATSAPP=true
AI_LIVE_PROVIDER_CALLS=false
WORKER_RUN_SCHEDULERS=false
WORKER_POLL_MS=1000
ACE_LIVE_INTERVAL_MS=3000
ACE_LIVE_AI_INTERVAL_MS=60000
ACE_LIVE_STATUS_PORT=5174
