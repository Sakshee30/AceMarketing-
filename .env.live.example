# Copy to .env.live.local. Use a dedicated LOCAL PostgreSQL database.
NODE_ENV=development
PORT=3001
DEFAULT_WORKSPACE_ID=ws_default
DATABASE_URL=postgresql://ace_live:CHANGE_ME@127.0.0.1:5432/ace_live
ACE_LIVE_WSL=false
# Python 3.11-3.13 executable; use python3 on macOS/Linux if needed.
PYTHON_BIN=python
# Native Python 3.9+ for the synthetic data feed (scripts/live/ace_feed.py, standard library only).
# Required only when ACE_LIVE_WSL=true, because WSL's Python cannot reach the Windows-hosted API.
# ACE_FEED_PYTHON=C:\path\to\python.exe
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=demo123
ACE_LOCAL_PASSWORD=demo123
ML_SERVICE_URL=http://127.0.0.1:8000
# live:setup -- --native generates missing local secrets and installs Python dependencies.
JWT_SECRET=
ML_SERVICE_AUTH_TOKEN=
CALL_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
ACE_ENABLE_AI=true
# Set to true only after GET /api/ai/ml/capabilities confirms the local estimators run here.
# It lets qualified, approved local models be deployed; without it they stay blocked.
AI_LOCAL_ML_CAPABILITY_VERIFIED=false
# Optional Chronos-2 forecasting: pinned snapshot revision and its provisioned directory.
# CHRONOS2_REVISION=
# CHRONOS2_SNAPSHOT_DIR=
ACE_ENABLE_CALL_TRACKING=true
ACE_ENABLE_WHATSAPP=true
AI_LIVE_PROVIDER_CALLS=false
WORKER_RUN_SCHEDULERS=false
WORKER_POLL_MS=1000
ACE_LIVE_INTERVAL_MS=3000
ACE_LIVE_AI_INTERVAL_MS=60000
ACE_LIVE_STATUS_PORT=5174
# Grounded analyst on an OpenAI-compatible NVIDIA endpoint. Keep the key only in .env.live.local.
# The route still has to pass access verification, the grounding evaluation, approval and deployment.
# AI_ANALYST_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_LIVE_PROVIDER_CALLS=true
# AI_PROVIDER_TESTS_ENABLED=true
# AI_PROVIDER_TIMEOUT_MS=110000
# AI_JOB_DEADLINE_MS=300000
