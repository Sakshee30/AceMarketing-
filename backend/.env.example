NODE_ENV=production
PORT=3001
AUTH_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=salt:scrypt-hex
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
DATA_FILE=backend/data/ace-state.json
RATE_LIMIT_PER_MINUTE=240
TOKEN_TTL_SECONDS=3600

CONNECTOR_ENCRYPTION_KEY=replace-with-32-plus-random-characters
CONNECTOR_OAUTH_REDIRECT_URI=https://api.example.com/api/integrations/oauth/callback
CONNECTOR_OAUTH_SUCCESS_URL=https://app.example.com/#/workspace
CONNECTOR_OAUTH_STATE_SECRET=replace-with-a-random-secret-at-least-32-characters

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=

DATABASE_URL=postgresql://ace:ace@127.0.0.1:5432/acemarketing
DB_SSL=disable
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DEFAULT_WORKSPACE_ID=ws_default
ALLOW_FILE_STORE_IN_PRODUCTION=false

WORKER_BATCH_SIZE=10
WORKER_POLL_MS=1000
WORKER_LEASE_MS=60000
WORKER_DB_POOL_MAX=10

META_GRAPH_VERSION=v26.0
META_DATASET_ID=
META_TEST_EVENT_CODE=

GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION=

CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_SECRET=

CLICK_ID_RETENTION_DAYS=90
CALL_MATCH_WINDOW_MINUTES=30
ATTRIBUTION_DB_POOL_MAX=10

LEAD_OPS_DB_POOL_MAX=10

META_AD_ACCOUNT_ID=

GOOGLE_CUSTOMER_MATCH_MODE=legacy

ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CRM_API_VERSION=v8
SALESFORCE_INSTANCE_URL=
SALESFORCE_API_VERSION=v65.0

AGENT_DB_POOL_MAX=10
VOICE_AGENT_WEBHOOK_URL=
MEETING_REMINDER_WEBHOOK_URL=
AGENT_WEBHOOK_SECRET=

CUSTOM_INTEGRATION_TIMEOUT_MS=5000
CUSTOM_INTEGRATION_DB_POOL_MAX=10
CUSTOM_INTEGRATION_ALLOW_HTTP=false

OBSERVABILITY_DB_POOL_MAX=10
MONITORING_EVAL_INTERVAL_MS=60000
API_METRIC_RETENTION_DAYS=30

ENTITLEMENT_DB_POOL_MAX=10
PLAN_LIMIT_TRACKED_EVENTS=1000000
PLAN_LIMIT_ASSISTED_EVENTS=250000
PLAN_LIMIT_SIGNAL_DISPATCHES=250000
PLAN_LIMIT_AGENT_ACTIONS=50000
PLAN_LIMIT_AUDIENCE_SYNCS=500
PLAN_LIMIT_CUSTOM_INTEGRATION_TESTS=1000
PLAN_LIMIT_MEMBERS=25
PLAN_LIMIT_CUSTOM_INTEGRATIONS=25

BILLING_DB_POOL_MAX=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_CHECKOUT_SUCCESS_URL=https://app.example.com/#/workspace
BILLING_CHECKOUT_CANCEL_URL=https://app.example.com/#/workspace
BILLING_PORTAL_RETURN_URL=https://app.example.com/#/workspace
BILLING_PLAN_CATALOG_JSON={}

# Docker Compose host/runtime
POSTGRES_DB=acemarketing
POSTGRES_USER=ace
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ACE_HTTP_PORT=8080

# Operational tooling
BACKUP_DIR=backups
SMOKE_BASE_URL=http://127.0.0.1:3001
SMOKE_TIMEOUT_MS=5000

CONSENT_POLICY_VERSION=v1
CONSENT_DB_POOL_MAX=10

PRIVACY_DB_POOL_MAX=10
PRIVACY_RETENTION_CLICK_DAYS=0
PRIVACY_RETENTION_ASSISTED_DAYS=0
PRIVACY_RETENTION_LEAD_DAYS=0
PRIVACY_RETENTION_CONSENT_DAYS=0
PRIVACY_RETENTION_DRY_RUN=true

AUDIENCE_SCHEDULER_DB_POOL_MAX=5
AUDIENCE_SCHEDULER_BATCH_SIZE=5
AUDIENCE_SCHEDULER_POLL_MS=15000

COHORT_DB_POOL_MAX=5
COHORT_QUALIFIED_EVENTS=lead.qualified,qualified_lead,mql,sql
COHORT_CONSULTATION_EVENTS=consultation,consultation_booked,appointment,meeting_booked
COHORT_CONVERSION_EVENTS=purchase,enrolment,enrollment,booking,revenue.closed,closed_won,sale

EVENT_RULE_DB_POOL_MAX=5

REPORT_DB_POOL_MAX=5
REPORT_SCHEDULER_BATCH_SIZE=5
REPORT_SCHEDULER_POLL_MS=30000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OAUTH_REFRESH_SKEW_SECONDS=300
HUBSPOT_OAUTH_TOKEN_URL=https://api.hubapi.com/oauth/2026-03/token
SALESFORCE_OAUTH_TOKEN_URL=https://login.salesforce.com/services/oauth2/token
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# LinkedIn Ads / Conversions API
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
# urn:lla:llaPartnerConversion:<conversion-rule-id>
LINKEDIN_CONVERSION_URN=
# YYYYMM LinkedIn Marketing API version; keep aligned with LinkedIn's supported versions.
LINKEDIN_MARKETING_VERSION=202609

# Microsoft Advertising Conversions API (UET server-side CAPI)
# The tag ID and CAPI token come from the Microsoft Advertising UET setup.
MICROSOFT_UET_TAG_ID=
MICROSOFT_CAPI_TOKEN=

# Pinterest Conversions API
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_CONVERSION_TOKEN=
# Set true only when validating in Pinterest's test-event flow.
PINTEREST_TEST_EVENTS=false

# TikTok Events API 2.0
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=
# Optional Events Manager test-event code.
TIKTOK_TEST_EVENT_CODE=

# Voice Scheduler agent transport
# HTTPS endpoint that receives scheduling requests and returns a confirmed startsAt / confirmedStartsAt when a booking is secured.
VOICE_SCHEDULER_WEBHOOK_URL=

# X Ads Conversion API
# Pixel ID and Conversion API access token from X Ads Events Manager.
X_PIXEL_ID=
X_CONVERSION_TOKEN=


# Multi-model intelligence runtime
# Live provider execution is opt-in and remains blocked until model documentation,
# account access, evaluation, approval and deployment gates are satisfied.
AI_LIVE_PROVIDER_CALLS=false
# Explicitly opt in only for bounded authorized credential/model access verification.
AI_PROVIDER_TESTS_ENABLED=false
# Live voice requires tenant qualification, approval and deployment in addition to these runtime flags.
AI_LIVE_VOICE_ENABLED=false
AI_LIVE_VOICE_MAX_DURATION_MS=1800000
AI_LIVE_VOICE_MAX_INPUT_BYTES=67108864
AI_LIVE_VOICE_MAX_OUTPUT_BYTES=67108864
AI_LIVE_VOICE_MAX_RECONNECTS=2
GOOGLE_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
AI_PROVIDER_TIMEOUT_MS=45000
AI_JOB_DEADLINE_MS=120000
AI_JOB_MAX_ATTEMPTS=2
AI_JOB_EVENT_STREAM_MAX_MS=120000
AI_DB_POOL_MAX=5

# Knowledge retrieval. Production semantic vector search requires PostgreSQL
# with the pgvector extension already provisioned; embedded development uses a
# bounded application-side cosine fallback.
KNOWLEDGE_VECTOR_BACKEND=disabled
KNOWLEDGE_CHUNK_CHARS=6000
KNOWLEDGE_CHUNK_OVERLAP_CHARS=600
KNOWLEDGE_MAX_TEXT_BYTES=2000000
# Optional immutable platform ceiling. JSON only; never include secrets.
# Example: {"version":"platform-ai.v1","defaults":{"maxConcurrentJobs":20},"tasks":{"creative_image":{"enabled":false}}}
AI_PLATFORM_POLICY_JSON=

OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

ANTHROPIC_API_KEY=

GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

VOYAGE_API_KEY=
VOYAGE_EMBEDDINGS_URL=https://api.voyageai.com/v1/embeddings
VOYAGE_RERANK_URL=https://api.voyageai.com/v1/rerank

# Internal specialist-model service. Leave blank until the ML service is deployed
# with authenticated internal transport and evaluated artifacts.
ML_SERVICE_URL=
ML_SERVICE_AUTH_TOKEN=
# Optional isolated specialist runtimes. Leave blank until the corresponding
# service/profile is deployed and authorized.
ML_FORECAST_SERVICE_URL=
ML_FORECAST_SERVICE_AUTH_TOKEN=
ML_CAUSAL_SERVICE_URL=
ML_CAUSAL_SERVICE_AUTH_TOKEN=
ML_MMM_SERVICE_URL=
ML_MMM_SERVICE_AUTH_TOKEN=

# Direct supervised training payloads are blocked in production by default.
# Production training should reference immutable /api/ai/datasets snapshots.
AI_ALLOW_INLINE_TRAINING=false

# Chronos checkpoint must be pinned before forecast_primary can execute.
CHRONOS2_REVISION=
CHRONOS2_SNAPSHOT_DIR=
CHRONOS2_EXPECTED_SHA256=
CHRONOS2_ALLOW_DOWNLOAD=false
CHRONOS2_DEVICE=cpu

ML_SERVICE_TIMEOUT_MS=120000
ML_JOB_DEADLINE_MS=900000
ML_JOB_MAX_ATTEMPTS=2
ML_ENV=development
ML_ARTIFACT_DIR=/tmp/acemarketing-ml-artifacts
ML_ARTIFACT_S3_BUCKET=
ML_ARTIFACT_S3_PREFIX=acemarketing/ml-artifacts
ML_ARTIFACT_S3_ENDPOINT=
ML_ARTIFACT_S3_REGION=
ML_ARTIFACT_S3_SSE=AES256

# Operator-only AI lifecycle scripts (do not commit real tokens)
AI_API_BASE_URL=http://127.0.0.1:3001
AI_WORKSPACE_ID=ws_default
AI_API_TOKEN=

# AI object storage. Local storage is for development/test only.
# Production should use the authenticated HTTP object-storage gateway.
AI_OBJECT_STORE_BACKEND=local
AI_OBJECT_STORE_LOCAL_DIR=/tmp/acemarketing-ai-objects
AI_OBJECT_STORE_URL=
AI_OBJECT_STORE_TOKEN=
AI_OBJECT_STORE_TIMEOUT_MS=30000
AI_OBJECT_STORE_MAX_BYTES=20971520
AI_OBJECT_STORE_ALLOW_LOCAL_IN_PROD=false
AI_TRANSCRIPT_RETENTION_DAYS=30

ANTHROPIC_MODELS_URL=https://api.anthropic.com/v1/models

# High-risk provider-side AI activation execution is disabled by default.
AI_ACTIVATION_EXECUTION_ENABLED=false
AI_ACTIVATION_EXECUTION_MAX_ATTEMPTS=1
AI_ACTIVATION_EXECUTION_DEADLINE_MS=120000
