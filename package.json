{
  "name": "ace-marketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "node backend/src/index.mjs",
    "api": "node backend/src/index.mjs",
    "build": "tsc -b && vite build",
    "build:frontend": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "check:frontend": "tsc -b",
    "check:backend": "node --check backend/src/index.mjs && node --check backend/src/security.mjs && node --check backend/src/store.mjs && node --check backend/src/public-content.mjs",
    "check:all": "npm run check:frontend && npm run check:backend"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
