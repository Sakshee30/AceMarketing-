pipeline {
  agent { label 'ace-qa-linux-isolated' }
  options { timestamps(); disableConcurrentBuilds(); timeout(time: 60, unit: 'MINUTES') }
  stages {
    stage('Checkout candidate') { steps { checkout scm } }
    stage('Install locked dependencies') { steps { sh 'npm ci'; sh 'npx playwright install chromium firefox webkit' } }
    stage('Isolated application tests') { steps { sh 'bash qa/run-isolated.sh' } }
  }
  post {
    always {
      junit testResults: 'artifacts/prelive/*.junit.xml', allowEmptyResults: false
      archiveArtifacts artifacts: 'artifacts/prelive/**', allowEmptyArchive: false, fingerprint: true
    }
  }
}
